{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/viggomeesters/callersignal/main/schemas/source-evidence.schema.json",
  "title": "CallerSignal Source Evidence",
  "description": "An immutable source observation. It records what a source stated and its limits; it is neither a community report nor a computed assessment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "evidence_id",
    "source",
    "subject",
    "observation",
    "freshness",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "kind": { "const": "source_evidence" },
    "evidence_id": { "$ref": "#/$defs/evidence_id" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "name",
        "authority_type",
        "jurisdiction",
        "locator",
        "reuse_basis",
        "license"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/token" },
        "name": { "type": "string", "minLength": 3, "maxLength": 160 },
        "authority_type": {
          "enum": [
            "official_regulator",
            "numbering_administrator",
            "licensed_data_provider",
            "verified_organization",
            "moderated_community_aggregate"
          ]
        },
        "jurisdiction": {
          "oneOf": [
            { "type": "string", "pattern": "^[A-Z]{2}$" },
            { "const": "global" }
          ]
        },
        "locator": { "type": "string", "format": "uri" },
        "reuse_basis": { "type": "string", "minLength": 20, "maxLength": 500 },
        "license": { "type": "string", "minLength": 3, "maxLength": 200 }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "canonical_e164"],
      "properties": {
        "kind": {
          "enum": ["phone_number", "number_range", "numbering_plan"]
        },
        "canonical_e164": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{1,14}$"
        },
        "range_prefix": {
          "type": ["string", "null"],
          "pattern": "^\\+[1-9][0-9]{0,14}$"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_class",
        "claim_type",
        "value",
        "publication_status",
        "verification_status",
        "confidence",
        "reason_codes",
        "limitations"
      ],
      "properties": {
        "evidence_class": {
          "enum": [
            "number_plan_fact",
            "range_allocation",
            "provider_claim",
            "identity_claim",
            "regulatory_notice",
            "licensed_reputation_observation",
            "community_report_aggregate"
          ]
        },
        "claim_type": {
          "enum": [
            "country_assignment",
            "number_type",
            "reserved_status",
            "range_holder",
            "original_carrier",
            "current_provider_claim",
            "subscriber_identity_claim",
            "reachability_claim",
            "regulatory_status",
            "reported_activity_summary",
            "reputation_status"
          ]
        },
        "value": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 500 },
            { "type": "number" },
            { "type": "boolean" },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 120 }
            }
          ]
        },
        "publication_status": {
          "enum": ["public", "restricted"]
        },
        "verification_status": {
          "enum": ["observed", "unverified", "verified", "contradicted", "withdrawn"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/token" }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 12, "maxLength": 500 }
        },
        "reputation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "source_native_value", "sample_basis"],
          "properties": {
            "category": {
              "enum": [
                "spam",
                "phishing",
                "scam",
                "telemarketing",
                "robocall",
                "nuisance",
                "no_current_risk_match"
              ]
            },
            "source_native_value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^(?![Ss][Aa][Ff][Ee]$).+$"
            },
            "sample_basis": {
              "enum": [
                "official_regulatory_observation",
                "licensed_provider_aggregate",
                "moderated_community_aggregate",
                "source_no_match"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "category": { "const": "no_current_risk_match" }
                },
                "required": ["category"]
              },
              "then": {
                "properties": {
                  "sample_basis": { "const": "source_no_match" }
                }
              },
              "else": {
                "properties": {
                  "sample_basis": { "not": { "const": "source_no_match" } }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": { "evidence_class": { "const": "identity_claim" } },
                "required": ["evidence_class"]
              },
              {
                "properties": {
                  "claim_type": { "const": "subscriber_identity_claim" }
                },
                "required": ["claim_type"]
              }
            ]
          },
          "then": {
            "properties": { "publication_status": { "const": "restricted" } }
          }
        },
        {
          "if": {
            "properties": { "claim_type": { "const": "reputation_status" } },
            "required": ["claim_type"]
          },
          "then": {
            "required": ["reputation"],
            "properties": {
              "evidence_class": {
                "enum": [
                  "regulatory_notice",
                  "licensed_reputation_observation",
                  "community_report_aggregate"
                ]
              },
              "value": {
                "enum": [
                  "spam",
                  "phishing",
                  "scam",
                  "telemarketing",
                  "robocall",
                  "nuisance",
                  "no_current_risk_match"
                ]
              }
            }
          },
          "else": {
            "not": { "required": ["reputation"] }
          }
        }
      ]
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieved_at",
        "source_published_at",
        "valid_until",
        "status",
        "max_age_seconds"
      ],
      "properties": {
        "retrieved_at": { "type": "string", "format": "date-time" },
        "source_published_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "valid_until": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "status": { "enum": ["current", "stale", "unknown"] },
        "max_age_seconds": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_document_id",
        "source_record_id",
        "transformation_version",
        "content_digest"
      ],
      "properties": {
        "source_document_id": { "type": "string", "minLength": 1, "maxLength": 240 },
        "source_record_id": {
          "type": ["string", "null"],
          "maxLength": 240
        },
        "transformation_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "observation": {
            "properties": { "claim_type": { "const": "reputation_status" } },
            "required": ["claim_type"]
          }
        },
        "required": ["observation"]
      },
      "then": {
        "properties": {
          "subject": {
            "properties": { "kind": { "const": "phone_number" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "evidence_id": {
      "type": "string",
      "pattern": "^ev_[A-Za-z0-9_-]{8,96}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$"
    }
  }
}
