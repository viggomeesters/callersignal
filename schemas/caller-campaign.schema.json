{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/viggomeesters/callersignal/main/schemas/caller-campaign.schema.json",
  "title": "CallerSignal Caller Campaign",
  "description": "A derived, spoofing-aware pattern of eligible observations about calls displaying bounded phone-number values. It does not identify a caller or subscriber.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "campaign_id",
    "title",
    "status",
    "risk_state",
    "subject_semantics",
    "categories",
    "jurisdictions",
    "membership",
    "timeline",
    "evidence",
    "confidence",
    "freshness",
    "recommended_actions",
    "correction",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "kind": { "const": "caller_campaign" },
    "campaign_id": { "type": "string", "pattern": "^cmp_[A-Za-z0-9_-]{8,64}$" },
    "title": { "type": "string", "minLength": 8, "maxLength": 120 },
    "status": { "enum": ["active", "monitoring", "resolved", "retracted"] },
    "risk_state": {
      "enum": ["official_warning", "elevated_signals", "insufficient_evidence"]
    },
    "subject_semantics": { "const": "calls_displaying_numbers_or_patterns" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "unwanted",
          "silent_call",
          "robocall",
          "impersonation_attempt",
          "payment_request",
          "credential_request",
          "harassment",
          "other"
        ]
      }
    },
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          { "type": "string", "pattern": "^[A-Z]{2}$" },
          { "const": "global" }
        ]
      }
    },
    "membership": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/member" }
    },
    "timeline": { "$ref": "#/$defs/timeline" },
    "evidence": { "$ref": "#/$defs/evidence" },
    "confidence": { "$ref": "#/$defs/confidence" },
    "freshness": { "$ref": "#/$defs/freshness" },
    "recommended_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "avoid_and_verify",
          "avoid_sensitive_actions",
          "stay_cautious",
          "treat_as_unknown",
          "verify_through_trusted_channel"
        ]
      }
    },
    "correction": { "$ref": "#/$defs/correction" },
    "limitations": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 20, "maxLength": 500 },
      "contains": { "type": "string", "pattern": "[Ss]poof" }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$"
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "subject_semantics", "identity_scope"],
      "properties": {
        "kind": { "enum": ["displayed_number", "bounded_pattern"] },
        "value": { "type": "string", "pattern": "^\\+[1-9][0-9]{1,14}$" },
        "following_digits": { "type": "integer", "minimum": 1, "maximum": 10 },
        "subject_semantics": { "const": "call_displayed_value" },
        "identity_scope": { "const": "no_caller_or_subscriber_identity_claim" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "bounded_pattern" } },
            "required": ["kind"]
          },
          "then": { "required": ["following_digits"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "displayed_number" } },
            "required": ["kind"]
          },
          "then": { "not": { "required": ["following_digits"] } }
        }
      ]
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_seen", "last_seen", "published_at", "updated_at"],
      "properties": {
        "first_seen": { "type": "string", "format": "date-time" },
        "last_seen": { "type": "string", "format": "date-time" },
        "published_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_evidence_ids",
        "source_ids",
        "source_diversity",
        "reason_codes",
        "excluded_reason_codes"
      ],
      "properties": {
        "eligible_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]{8,96}$" }
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/token" }
        },
        "source_diversity": { "type": "integer", "minimum": 0 },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/token" }
        },
        "excluded_reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/token" }
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "score"],
      "properties": {
        "level": { "enum": ["none", "low", "medium", "high"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "status"],
      "properties": {
        "as_of": { "type": "string", "format": "date-time" },
        "status": { "enum": ["current", "mixed", "stale", "no_eligible_evidence"] }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "updated_at", "reason_codes"],
      "properties": {
        "status": { "enum": ["none", "under_review", "corrected", "retracted"] },
        "updated_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/token" }
        }
      }
    }
  }
}
