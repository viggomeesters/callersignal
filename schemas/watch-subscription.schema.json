{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/viggomeesters/callersignal/main/schemas/watch-subscription.schema.json",
  "title": "CallerSignal Private Watch Subscription",
  "description": "A private, consented, contact-verified subscription for material risk-state changes. It stores keyed references rather than raw contact or phone values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "watch_id",
    "status",
    "subject",
    "contact",
    "consent",
    "verification",
    "notification",
    "correction",
    "created_at",
    "updated_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "kind": { "const": "watch_subscription" },
    "watch_id": { "type": "string", "pattern": "^watch_[a-f0-9]{24}$" },
    "status": { "enum": ["pending_verification", "active", "revoked", "expired"] },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number_ref", "semantics"],
      "properties": {
        "number_ref": { "type": "string", "pattern": "^num_[a-f0-9]{32}$" },
        "semantics": { "const": "displayed_number_digest" }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contact_ref", "visibility"],
      "properties": {
        "contact_ref": { "type": "string", "pattern": "^contact_[a-f0-9]{32}$" },
        "visibility": { "const": "private" }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "receipt_id", "purpose", "granted_at"],
      "properties": {
        "policy_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "receipt_id": { "type": "string", "pattern": "^consent_[a-f0-9]{24}$" },
        "purpose": { "const": "material_risk_change_notifications" },
        "granted_at": { "type": "string", "format": "date-time" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verified_at"],
      "properties": {
        "status": { "enum": ["pending", "verified"] },
        "verified_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_material_fingerprint", "last_notified_at"],
      "properties": {
        "last_material_fingerprint": {
          "oneOf": [
            { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        },
        "last_notified_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "updated_at", "reason_codes"],
      "properties": {
        "status": { "enum": ["none", "under_review", "corrected"] },
        "updated_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "active" } }, "required": ["status"] },
      "then": {
        "properties": {
          "verification": {
            "properties": { "status": { "const": "verified" } },
            "required": ["status"]
          }
        }
      }
    }
  ]
}
