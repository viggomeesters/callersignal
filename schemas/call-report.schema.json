{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/viggomeesters/callersignal/main/schemas/call-report.schema.json",
  "title": "CallerSignal Call Report",
  "description": "A privacy-minimized community observation about a call displaying a number. It is explicitly unverified and does not identify the subscriber or caller.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "report_id",
    "reported_at",
    "subject_semantics",
    "displayed_number",
    "observation",
    "attestations",
    "moderation",
    "privacy",
    "submission"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "kind": { "const": "call_report" },
    "report_id": {
      "type": "string",
      "pattern": "^rpt_[A-Za-z0-9_-]{8,64}$"
    },
    "reported_at": { "type": "string", "format": "date-time" },
    "subject_semantics": { "const": "call_displayed_number" },
    "displayed_number": {
      "$ref": "phone-number.schema.json"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "occurred_at",
        "channel",
        "contact_outcome",
        "categories"
      ],
      "properties": {
        "direction": { "const": "inbound" },
        "occurred_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "channel": { "enum": ["voice", "voicemail", "sms", "other"] },
        "contact_outcome": {
          "enum": ["unanswered", "answered", "voicemail", "message_received", "other"]
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "unwanted",
              "silent_call",
              "robocall",
              "impersonation_attempt",
              "payment_request",
              "credential_request",
              "harassment",
              "legitimate",
              "other"
            ]
          }
        }
      }
    },
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_observation",
        "understands_displayed_number_not_identity",
        "contains_no_sensitive_narrative"
      ],
      "properties": {
        "direct_observation": { "const": true },
        "understands_displayed_number_not_identity": { "const": true },
        "contains_no_sensitive_narrative": { "const": true }
      }
    },
    "moderation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_status", "verification_status", "reason_codes"],
      "properties": {
        "workflow_status": {
          "enum": ["pending", "accepted_observation", "rejected", "withdrawn"]
        },
        "verification_status": { "const": "unverified_observation" },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/token" }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "retention_policy_id",
        "retention_until",
        "contains_free_text"
      ],
      "properties": {
        "policy_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "retention_policy_id": { "$ref": "#/$defs/token" },
        "retention_until": { "type": "string", "format": "date-time" },
        "contains_free_text": { "const": false }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "receipt_id"],
      "properties": {
        "channel": { "enum": ["web", "http_api", "mcp", "moderator_import"] },
        "receipt_id": {
          "type": "string",
          "pattern": "^rcpt_[A-Za-z0-9_-]{8,64}$"
        }
      }
    },
    "reporter_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region"],
      "properties": {
        "region": {
          "oneOf": [
            { "type": "string", "pattern": "^[A-Z]{2}$" },
            { "type": "null" }
          ]
        }
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$"
    }
  }
}
